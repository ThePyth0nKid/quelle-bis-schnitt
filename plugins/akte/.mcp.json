{
  "mcpServers": {
    "akte": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "https://github.com/ThePyth0nKid/ultra-akte/archive/refs/tags/v0.3.0.zip#subdirectory=mcp",
        "akte-mcp"
      ],
      "env": {
        "AKTE_BASIS": "${user_config.basis}",
        "AKTE_TOKEN": "${user_config.token}"
      }
    }
  }
}
